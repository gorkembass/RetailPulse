# Copy to .env and adjust. These are local development defaults, not production secrets.
POSTGRES_USER=retailpulse
POSTGRES_PASSWORD=retailpulse
POSTGRES_DB=retailpulse
POSTGRES_PORT=5432
DASHBOARD_PORT=8501

# Used by the CLI and dashboard when they run on the host.
DATABASE_URL=postgresql+psycopg://retailpulse:retailpulse@localhost:5432/retailpulse

# Used by the PostgreSQL integration tests. Leave unset to skip them.
RETAILPULSE_TEST_DATABASE_URL=postgresql+psycopg://retailpulse:retailpulse@localhost:5432/retailpulse_test
